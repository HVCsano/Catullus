{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catullus",
  "version": "0.1.0",
  "identifier": "hu.HVCsano.Catullus",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Catullus",
        "width": 300,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "focus": true,
        "url": "/loader",
        "center": true,
        "label": "loader",
        "maximizable": false
      },
      {
        "title": "Catullus",
        "width": 800,
        "minHeight": 600,
        "minWidth": 800,
        "height": 600,
        "visible": false,
        "create": false,
        "label": "main",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNzBDMjlBMzAxMDVGODIKUldTQ1h4QXdtc0p3TVhsa1BUczRJMkkyZEJpa1RqdEdLRXVYYkU0SVpQZExPbFZKWm83d3EvclUK",
      "endpoints": [
        "https://github.com/HVCsano/Catullus/releases/latest/download/latest.json"
      ]
    }
  }
}